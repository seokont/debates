POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="ppp"
POSTGRES_PORT=5432

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ppp?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
USER_API_KEY_ENCRYPTION_SECRET="change-me-user-api-key-encryption-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379
PORT=3000

# ── Core AI providers (debate engine) ──────────────────────────────────
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
ANTHROPIC_VERSION="2023-06-01"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
XAI_API_KEY=""
XAI_MODEL="grok-3"
GLM_API_KEY=""
GLM_MODEL="glm-4-flash"
KIMI_API_KEY=""
KIMI_MODEL="moonshot-v1-8k"

# ── Cascade AI providers (Build Room agents) ────────────────────────────
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"

# ── Debate engine tuning ────────────────────────────────────────────────
DEBATE_AGENT_MAX_OUTPUT_TOKENS=1200
DEBATE_AGENT_RETRY_ATTEMPTS=3
DEBATE_AGENT_RETRY_DELAY_MS=1000
DEBATE_AGENT_FALLBACK_ON_ERROR=false

# ── Encryption ──────────────────────────────────────────────────────────
ENCRYPTION_SECRET="change-me-encryption-secret"

# ── Payments ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Auto-deploy (Build Room) ─────────────────────────────────────────────
GITHUB_TOKEN=""
RAILWAY_API_TOKEN=""

# ── Notifications ───────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_CONNECT_SECRET=""
