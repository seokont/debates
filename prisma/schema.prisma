generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String?
  googleId        String?        @unique
  username        String?
  avatarUrl       String?
  role            UserRole       @default(USER)
  balanceCredits  Int            @default(3)
  freeDebatesLeft Int            @default(3)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  refreshTokens   RefreshToken[]
  debates         Debate[]
  injections      HumanInjection[]
  comments        Comment[]
  commentLikes    CommentLike[]
  apiKeys         UserApiKey[]
  creditTransactions CreditTransaction[]
  notificationChannels NotificationChannel[]
  researchRequests    ResearchRequest[]
  expertVerifications ExpertVerification[]
  buildProjects       BuildProject[]
  taskClaims          TaskClaim[]
  exploreSessions     ExploreSession[]
  investorMatches     InvestorMatch[]
  corporateKeys       CorporateApiKey[]
  branchFunds         BranchFund[]
  royaltyShares       RoyaltyShare[]
  dataLicenses        DataLicense[]
  customModels        CustomModelEndpoint[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model Debate {
  id              String         @id @default(uuid())
  userId          String
  title           String?
  slug            String         @unique
  originalThesis  String
  currentThesis   String
  mode            DebateMode
  status          DebateStatus   @default(PENDING)
  visibility      Visibility     @default(PUBLIC)
  tier            DebateTier     @default(SURFACE)
  models          DebateAiModel[] @default([])
  roundCount      Int            @default(0)
  maxRounds       Int            @default(6)
  quietMode       Boolean        @default(false)

  layer1Summary         String?
  layer2Summary         String?
  finalSummary          String?
  finalThesis           String?
  opportunityScore      Int?
  childQuestions        String[]   @default([])
  researchGaps          String[]   @default([])
  crossDomainHypotheses String[]   @default([])

  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  sourceUrl       String?
  parentId        String?
  branchQuestion  String?

  user            User           @relation(fields: [userId], references: [id])
  parent          Debate?        @relation("DebateBranches", fields: [parentId], references: [id])
  branches        Debate[]       @relation("DebateBranches")
  rounds          DebateRound[]
  events          DebateEvent[]
  injections      HumanInjection[]
  comments        Comment[]
  researchRequests ResearchRequest[]
  buildProjects   BuildProject[]
  patentAlerts    PatentAlert[]
  opportunityReport OpportunityReport?
  branchFunds     BranchFund[]
  dataLicense     DataLicense?

  @@index([userId])
  @@index([visibility])
  @@index([status])
  @@index([createdAt])
  @@index([parentId])
}

model DebateRound {
  id               String      @id @default(uuid())
  debateId         String
  roundNumber      Int
  status           RoundStatus @default(RUNNING)

  inputThesis      String
  outputThesis     String?

  closedAttacks    Json?
  openWeaknesses   Json?
  improvementScore Float?

  startedAt        DateTime    @default(now())
  completedAt      DateTime?

  debate           Debate      @relation(fields: [debateId], references: [id], onDelete: Cascade)
  events           DebateEvent[]

  @@index([debateId])
  @@index([debateId, roundNumber])
  @@index([status])
}

model DebateEvent {
  id        String          @id @default(uuid())
  debateId  String
  roundId   String?
  type      DebateEventType
  agent     AiAgentName?
  role      AiAgentRole?
  content   String
  metadata  Json?
  createdAt DateTime        @default(now())

  debate    Debate          @relation(fields: [debateId], references: [id], onDelete: Cascade)
  round     DebateRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)

  @@index([debateId])
  @@index([roundId])
  @@index([type])
  @@index([agent])
  @@index([debateId, roundId])
  @@index([debateId, createdAt])
}

model HumanInjection {
  id         String          @id @default(uuid())
  debateId   String
  userId     String
  type       InjectionType
  content    String
  status     InjectionStatus @default(PENDING)
  likesCount Int             @default(0)
  paidAmount Int             @default(0)
  acceptedAt DateTime?
  createdAt  DateTime        @default(now())

  debate     Debate          @relation(fields: [debateId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([debateId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Comment {
  id         String        @id @default(uuid())
  debateId   String
  userId     String
  parentId   String?
  content    String
  likesCount Int           @default(0)
  createdAt  DateTime      @default(now())

  debate     Debate        @relation(fields: [debateId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes      CommentLike[]

  @@index([debateId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
}

model UserApiKey {
  id           String     @id @default(uuid())
  userId       String
  provider     AiProvider
  encryptedKey String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider])
  @@index([isActive])
}

model CreditTransaction {
  id              String                @id @default(uuid())
  userId          String
  type            CreditTransactionType
  amount          Int
  reason          String
  stripePaymentId String?
  createdAt       DateTime              @default(now())

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([stripePaymentId])
}

model NotificationChannel {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  value     String
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([isActive])
  @@index([userId, type, isActive])
}

enum UserRole {
  USER
  ADMIN
  EXPERT
}

enum DebateMode {
  CONVERGENT
  DIVERGENT
  GEOPOLITICAL
}

enum DebateStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum RoundStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum DebateEventType {
  ATTACK
  IMPROVEMENT
  VERIFICATION
  RESEARCH_GAP
  HUMAN
  SYSTEM
  FINAL
}

enum AiAgentName {
  GPT
  CLAUDE
  GEMINI
  GROK
  SYSTEM
}

enum AiAgentRole {
  SKEPTIC
  SYSTEMS_THINKER
  PRACTICIAN
  OPPONENT
  IMPROVER
  VERIFIER
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  XAI
}

enum CreditTransactionType {
  CREDIT
  DEBIT
}

enum NotificationType {
  TELEGRAM
  EMAIL
  WHATSAPP
}

enum InjectionType {
  ATTACK
  CLARIFY
  ALTERNATIVE
  EXAMPLE
}

enum InjectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  USED_IN_ROUND
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum DebateTier {
  SURFACE
  VERIFIED
  DEEP
}

enum DebateAiModel {
  GPT
  CLAUDE
  GEMINI
  GROK
}

model ResearchRequest {
  id          String          @id @default(uuid())
  debateId    String
  userId      String
  question    String
  context     String?
  status      ResearchStatus  @default(OPEN)
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())

  debate      Debate          @relation(fields: [debateId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([debateId])
  @@index([userId])
  @@index([status])
}

model ExpertVerification {
  id          String              @id @default(uuid())
  userId      String
  domain      String
  evidence    String
  status      VerificationStatus  @default(PENDING)
  reviewNote  String?
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime            @default(now())

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model BuildProject {
  id                String      @id @default(uuid())
  debateId          String
  userId            String
  slug              String      @unique
  title             String
  status            BuildStatus @default(PENDING)
  stack             Json?
  deployUrl         String?
  railwayProjectId  String?
  equityMap         Json?
  completedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  debate      Debate             @relation(fields: [debateId], references: [id])
  user        User               @relation(fields: [userId], references: [id])
  events      BuildProjectEvent[]
  tasks       ExchangeTask[]
  investorMatches InvestorMatch[]
  equityShares    RoyaltyShare[]

  @@index([debateId])
  @@index([userId])
  @@index([status])
}

model BuildProjectEvent {
  id          String          @id @default(uuid())
  projectId   String
  type        BuildEventType
  agent       String?
  content     String
  metadata    Json?
  createdAt   DateTime        @default(now())

  project     BuildProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
}

model ExchangeTask {
  id             String      @id @default(uuid())
  projectId      String?
  debateId       String?
  title          String
  description    String
  level          TaskLevel
  rewardCredits  Int?
  rewardPercent  Float?
  status         TaskStatus  @default(OPEN)
  deadline       DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  project        BuildProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  claims         TaskClaim[]

  @@index([projectId])
  @@index([status])
  @@index([level])
}

model TaskClaim {
  id              String      @id @default(uuid())
  taskId          String
  userId          String
  status          ClaimStatus @default(ACTIVE)
  completionNote  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  task            ExchangeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([status])
}

enum ResearchStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BuildStatus {
  PENDING
  BUILDING
  REVIEW
  DEPLOYED
  FAILED
}

enum BuildEventType {
  ARCHITECTURE
  CODE
  REVIEW
  CONFLICT
  FIXED
  TESTS
  AUDIT_PASSED
  DEPLOYED
  SYSTEM
}

enum TaskLevel {
  MICRO
  MINI
  TASK
  ROLE
}

enum TaskStatus {
  OPEN
  CLAIMED
  COMPLETED
  CANCELLED
}

enum ClaimStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model ExploreSession {
  id               String        @id @default(uuid())
  userId           String
  question         String
  exploreType      ExploreType
  mode             SessionMode
  status           SessionStatus @default(PENDING)
  generationsCount Int           @default(0)
  totalPaths       Int           @default(0)
  prunedPaths      Int           @default(0)
  budgetLimit      Float         @default(10.0)
  budgetUsed       Float         @default(0.0)
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  paths    ExplorePath[]
  insights ExploreInsight[]

  @@index([userId])
  @@index([status])
  @@index([mode])
}

model ExplorePath {
  id            String     @id @default(uuid())
  sessionId     String
  generation    Int
  hypothesis    String
  category      String?
  score         Float?
  scoreDetails  Json?
  status        PathStatus @default(ACTIVE)
  roundsAlive   Int        @default(0)
  parentPathId  String?
  generatedBy   String
  evaluations   Json?
  openQuestions String[]   @default([])
  createdAt     DateTime   @default(now())

  session  ExploreSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parent   ExplorePath?   @relation("PathTree", fields: [parentPathId], references: [id])
  children ExplorePath[]  @relation("PathTree")

  @@index([sessionId])
  @@index([sessionId, generation])
  @@index([status])
  @@index([score])
}

model ExploreInsight {
  id        String   @id @default(uuid())
  sessionId String?
  debateId  String?
  type      String
  content   String
  metadata  Json?
  createdAt DateTime @default(now())

  session ExploreSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([debateId])
  @@index([type])
}

model InvestorProfile {
  id            String   @id @default(uuid())
  name          String
  email         String?
  linkedinUrl   String?
  crunchbaseUrl String?
  domains       String[] @default([])
  description   String?
  source        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  matches InvestorMatch[]

  @@index([source])
}

model InvestorMatch {
  id             String         @id @default(uuid())
  projectId      String
  investorId     String
  userId         String
  matchScore     Float
  matchReason    String
  outreachStatus OutreachStatus @default(PENDING)
  emailSentAt    DateTime?
  emailBody      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  project  BuildProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  investor InvestorProfile @relation(fields: [investorId], references: [id])
  user     User            @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([investorId])
  @@index([outreachStatus])
}

model PromptPattern {
  id            String   @id @default(uuid())
  role          String
  pattern       String
  frequency     Int      @default(1)
  effectiveness Float?
  weekTag       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([role])
  @@index([weekTag])
}

enum ExploreType {
  STARTUPS
  SCIENCE
  SOLUTIONS
  ANOMALY
}

enum SessionMode {
  EXPLORE
  QUANTUM
}

enum SessionStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

enum PathStatus {
  ACTIVE
  PRUNED
  WINNER
  DEEPENED
}

enum OutreachStatus {
  PENDING
  SENT
  REPLIED
  CONVERTED
}

model PatentAlert {
  id           String      @id @default(uuid())
  debateId     String
  userId       String
  type         PatentType
  title        String
  description  String
  priorArtRisk Float
  noveltyScore Float
  status       AlertStatus @default(NEW)
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  debate Debate @relation(fields: [debateId], references: [id], onDelete: Cascade)

  @@index([debateId])
  @@index([userId])
  @@index([status])
}

model OpportunityReport {
  id          String   @id @default(uuid())
  debateId    String   @unique
  title       String
  executive   String
  methodology String
  findings    Json
  insights    Json
  gaps        String[]
  score       Int
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  debate Debate @relation(fields: [debateId], references: [id], onDelete: Cascade)

  @@index([debateId])
}

model CorporateApiKey {
  id          String   @id @default(uuid())
  userId      String
  name        String
  keyHash     String   @unique
  keyPrefix   String
  tier        CorpTier @default(STARTER)
  rateLimit   Int      @default(100)
  callsToday  Int      @default(0)
  callsTotal  Int      @default(0)
  lastResetAt DateTime @default(now())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
  @@index([isActive])
}

model BranchFund {
  id             String     @id @default(uuid())
  debateId       String
  userId         String
  amountCredits  Int
  royaltyPercent Float
  status         FundStatus @default(ACTIVE)
  returnedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  debate Debate @relation(fields: [debateId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([debateId])
  @@index([userId])
  @@index([status])
}

model RoyaltyShare {
  id          String    @id @default(uuid())
  projectId   String
  userId      String
  role        ShareRole
  percent     Float
  vestingDays Int       @default(0)
  isLocked    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project BuildProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
}

enum PatentType {
  PROCESS
  COMPOSITION
  MACHINE
  DESIGN
  PLANT
}

enum AlertStatus {
  NEW
  REVIEWED
  FILED
  DISMISSED
}

enum CorpTier {
  STARTER
  GROWTH
  ENTERPRISE
}

enum FundStatus {
  ACTIVE
  COMPLETED
  RETURNED
}

enum ShareRole {
  AUTHOR
  EXPERT
  BUILDER
  PLATFORM
  RESERVE
}

model DataLicense {
  id           String      @id @default(uuid())
  debateId     String      @unique
  userId       String
  licenseType  LicenseType @default(CC_BY)
  priceCredits Int         @default(0)
  title        String
  description  String
  totalUses    Int         @default(0)
  isPublished  Boolean     @default(false)
  publishedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  debate Debate             @relation(fields: [debateId], references: [id], onDelete: Cascade)
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  usages DataLicenseUsage[]

  @@index([userId])
  @@index([isPublished])
  @@index([licenseType])
}

model DataLicenseUsage {
  id        String   @id @default(uuid())
  licenseId String
  userId    String
  purpose   String
  createdAt DateTime @default(now())

  license DataLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@index([userId])
}

model CustomModelEndpoint {
  id           String   @id @default(uuid())
  userId       String
  name         String
  baseUrl      String
  encryptedKey String
  modelId      String
  provider     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

enum LicenseType {
  CC0
  CC_BY
  CC_BY_SA
  COMMERCIAL
}
